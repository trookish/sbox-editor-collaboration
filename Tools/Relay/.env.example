# Copy to .env (which is git-ignored) and fill in both values. Never commit .env.

# The DNS name of this server, for example relay.example.com. It must already resolve to this machine.
RELAY_HOST=

# A long random secret only YOU (the host) know. Generate one with:
#   openssl rand -hex 32
# or, on Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
# Put the same value, on one line, in .collaboration/relay-access-key.txt on the machine that hosts sessions.
RELAY_ACCESS_KEYS=
